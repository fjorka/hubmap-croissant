    {
      "@type": "cr:FileObject",
      "@id": "antibody-panel-xlsx",
      "name": "antibody-panel-xlsx",
      "description": "Antibody panel workbook (18 antibodies): clone, vendor, catalogue number, conjugated barcode, dilution. Marker-to-gene mapping lives here.",
      "contentUrl": "https://assets.hubmapconsortium.org/077f7862f6306055899374c7807a30c3/Pre FEB2020_Antibody_Panel1_UF .xlsx",
