    },
    {
      "@type": "cr:FileSet",
      "@id": "raw-acquisition-tiles",
      "name": "raw-acquisition-tiles",
      "description": "9,000 raw Keyence BZ-X800 TIFFs, 38 GB. 9 cycles x 1 region x 4 channels x tile positions x z-planes. Each file 1920x1440, 16-bit, LZW-compressed, single plane. Filename pattern <tile>_<NNNNN>_Z<zzz>_CH<c>.tif.",
      "containedIn": {
        "@id": "dataset-archive"
      },
      "encodingFormat": "image/tiff",
      "includes": "src_CX_19-002_LN_R2/cyc*_reg*/*.tif"
    },
    {
      "@type": "cr:FileSet",
      "@id": "processed-tiles",
      "name": "processed-tiles",
      "description": "2,268 flat-field-corrected, drift-compensated, best-focus tiles, 16-bit. Filename pattern reg<r>_X<xx>_Y<yy>_t<ttt>_z<zzz>_c<ccc>.tif.",
      "containedIn": {
        "@id": "dataset-archive"
      },
      "encodingFormat": "image/tiff",
      "includes": "drv_CX_19-002_lymph-node_R2/processed_2020-02-18/tiles/reg*_X*_Y*/*.tif"
    },
    {
      "@type": "cr:FileSet",
      "@id": "stitched-channel-images",
      "name": "stitched-channel-images",
      "description": "37 stitched whole-region mosaics, one per (cycle, channel) slot. Each 9408x9072, 16-bit, uncompressed, ~170 MB. The marker name is encoded in the filename: reg<r>_cyc<cc>_ch<c>_<MARKER>.tif. This is the layer most ML work would start from.",
      "containedIn": {
        "@id": "dataset-archive"
      },
      "encodingFormat": "image/tiff",
      "includes": "drv_CX_19-002_lymph-node_R2/processed_2020-02-18/stitched/reg001/*.tif"
    },
    {
      "@type": "cr:FileSet",
      "@id": "segmentation-masks",
      "name": "segmentation-masks",
      "description": "63 per-tile segmentation region masks (PNG), one per processed tile position. Filename pattern regions_reg<r>_X<xx>_Y<yy>_Z<zz>.png.",
      "containedIn": {
        "@id": "dataset-archive"
      },
      "encodingFormat": "image/png",
      "includes": "drv_CX_19-002_lymph-node_R2/processed_2020-02-18/segm/segm-1/masks/reg*_X*_Y*/*.png"
    },
    {
      "@type": "cr:FileSet",
      "@id": "segmentation-features",
      "name": "segmentation-features",
      "description": "196 per-tile segmentation outputs: per-cell feature tables and Gabriel graph neighbour lists.",
      "containedIn": {
        "@id": "dataset-archive"
      },
      "encodingFormat": "text/plain",
      "includes": "drv_CX_19-002_lymph-node_R2/processed_2020-02-18/segm/segm-1/fcs/*.txt"
    },
    {
      "@type": "cr:FileSet",
      "@id": "pipeline-diagnostics",
      "name": "pipeline-diagnostics",
      "description": "1,734 quality-control artefacts from the processing pipeline (flat-field estimates, focal maps, tile registration reports). Provenance evidence, not analysis input.",
      "containedIn": {
        "@id": "dataset-archive"
      },
      "encodingFormat": "image/tiff",
      "includes": "drv_CX_19-002_lymph-node_R2/processed_2020-02-18/diagnostics/**/*"
    }
  ],
